# -----------------------------------------------------------------------------
# Research Hub environment configuration
#
# All variables below are SERVER-ONLY. They are read by `npm run server` /
# `npm run start` (the Node auth server). Nothing here is bundled into the
# frontend — the Vite client never needs secrets.
#
# Copy this file to `.env` and fill in your values. Never commit a real
# `.env` file. The placeholders here are safe to commit.
# -----------------------------------------------------------------------------

# Port the authentication server listens on. The Vite dev server proxies
# /api to this port (see vite.config.ts).
PORT=4000

# Directory where the server stores user accounts (server-data/users.json).
# Must be writable by the server process. Keep it out of version control.
DATA_DIR=./server-data

# Session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168

# Set to "true" when serving over HTTPS (production). The session cookie will
# then carry the Secure attribute. Local development (http) must leave this
# unset or false.
COOKIE_SECURE=false

# Set to "production" to disable dev-only conveniences (e.g. returning the
# password-reset link in the API response instead of only logging it).
NODE_ENV=development

# -----------------------------------------------------------------------------
# SMTP email delivery (optional)
#
# Leave all of these unset to keep the dev fallback: the reset link is written
# to the server console (and, in development, returned by the API) instead of
# being emailed. To actually receive reset links in your inbox, configure an
# SMTP provider:
#
#   - Gmail:      SMTP_HOST=smtp.gmail.com       SMTP_PORT=587  SMTP_USER=you@gmail.com
#                 SMTP_PASS=<an App Password, not your account password>
#   - Outlook:    SMTP_HOST=smtp.office365.com   SMTP_PORT=587
#   - Mailgun/Postmark/any relay: use the SMTP host/port/credentials they give you.
#
# For port 465 (implicit TLS) set SMTP_SECURE=true; for 587 leave it unset.
# -----------------------------------------------------------------------------

# SMTP relay host. Leave empty to disable email delivery.
SMTP_HOST=
# Port 587 (STARTTLS) unless your provider uses 465.
SMTP_PORT=587
# Set to "true" only when connecting over implicit TLS on port 465.
SMTP_SECURE=false
# Username for SMTP auth (often your email address).
SMTP_USER=
# SMTP password or App Password. Never share this file.
SMTP_PASS=
# "From" address shown on sent mail (required once SMTP is enabled).
MAIL_FROM=

# Base URL used when building password-reset links. Leave empty to derive it
# from the request host, or set it when the server runs behind a proxy or when
# you browse via the Vite dev server (e.g. http://localhost:5173).
APP_BASE_URL=